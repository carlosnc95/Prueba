# Copia este archivo a ".env" (ya está en .gitignore, no se sube al repo)
# y rellena los valores reales. Sin RESEND_API_KEY el endpoint
# /api/diagnostico devolverá error 502 al intentar enviar el email.

# API key de tu cuenta de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente. Sin dominio propio verificado en Resend, usa el de pruebas
# "onboarding@resend.dev" (solo entrega a la dirección con la que te
# registraste en Resend). Cuando verifiques tu dominio, cámbialo a algo
# como "diagnostico@sira.ai".
RESEND_FROM_EMAIL=onboarding@resend.dev

# A qué email quieres que lleguen los diagnósticos del chat.
# Sin dominio verificado en Resend, esto SOLO puede ser el email con el
# que te registraste en Resend (la API lo rechaza con 403 si no). En
# cuanto verifiques un dominio, puedes cambiarlo a hola@sira.ai.
RESEND_TO_EMAIL=hola@sira.ai

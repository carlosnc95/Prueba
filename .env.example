# Copia este archivo a ".env" (ya está en .gitignore, no se sube al repo)
# y rellena los valores reales. Sin RESEND_API_KEY el endpoint
# /api/diagnostico devolverá error 502 al intentar enviar el email.

# API key de tu cuenta de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente. El dominio mdsia.com está verificado en Resend (región
# EU / eu-west-1), así que vale cualquier dirección @mdsia.com. No hace
# falta que sea un buzón real: las respuestas no van aquí, el código
# pone replyTo con el email de quien rellena el chat.
RESEND_FROM_EMAIL=diagnostico@mdsia.com

# A qué email quieres que lleguen los diagnósticos del chat.
# Este SÍ tiene que ser un buzón que exista de verdad.
RESEND_TO_EMAIL=hola@mdsia.com

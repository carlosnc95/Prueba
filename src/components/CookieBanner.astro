---
// Banner de consentimiento + carga de Google Analytics 4.
//
// Reglas que cumple (guía de cookies de la AEPD, art. 22.2 LSSI-CE):
//  - Bloqueo previo: gtag.js NO se descarga hasta que hay un "Aceptar".
//    No basta con cargarlo en modo denegado, porque la mera petición ya
//    envía la IP del visitante a Google.
//  - "Rechazar" tiene el mismo peso visual que "Aceptar". Nada de un
//    enlace pequeño frente a un botón grande.
//  - Seguir navegando NO es consentimiento: el banner espera una decisión.
//  - El consentimiento se puede retirar después, desde /privacidad.
//
// Accesibilidad: es role="region", no role="dialog". Un dialog implica que
// el foco se mueve dentro y queda atrapado; aquí no bloqueamos la página, y
// anunciarlo como diálogo sin gestionar el foco confunde a los lectores de
// pantalla. Como región con nombre es navegable, y el aria-live avisa
// cuando aparece.
//
// La decisión se guarda en localStorage. Eso también es almacenamiento en
// el dispositivo, pero está exento por ser estrictamente necesario: es lo
// que evita volver a preguntar en cada página.
import { site, routes } from '../config/site';

const gaId = site.ga4Id;
---

{
  gaId && (
    <div
      class="cookie-banner"
      data-cookie-banner
      data-ga-id={gaId}
      role="region"
      aria-label="Consentimiento de cookies"
      aria-live="polite"
      hidden
    >
      <p class="cookie-banner__title">Cookies de medición</p>
      <p class="cookie-banner__body">
        Usamos Google Analytics para ver qué páginas se visitan. Si lo rechazas no se instala ninguna cookie
        y la web funciona igual.{' '}
        <a href={routes.privacidad} aria-label="Más detalle en la política de privacidad">Más detalle</a>.
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="cookie-btn" data-cookie-reject>
          Rechazar
        </button>
        <button type="button" class="cookie-btn" data-cookie-accept>
          Aceptar
        </button>
      </div>
    </div>
  )
}

<script>
  const KEY = 'mds:consent:analytics';
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  if (banner) {
    const gaId = banner.dataset.gaId ?? '';

    const safeGet = () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };

    const safeSet = (v: string) => {
      try {
        localStorage.setItem(KEY, v);
      } catch {
        /* modo privado o almacenamiento bloqueado: se preguntará otra vez */
      }
    };

    let loaded = false;
    const loadGA = () => {
      if (loaded || !gaId) return;
      loaded = true;

      const w = window as unknown as { dataLayer?: unknown[]; gtag?: (...a: unknown[]) => void };
      w.dataLayer = w.dataLayer || [];

      // OJO: gtag.js solo interpreta como comando las entradas del dataLayer
      // que son el objeto `arguments`. Si se empuja un array normal (lo que
      // pasa al usar parámetros rest o una arrow function), el tag se carga
      // y `gtag` existe, pero 'js' y 'config' se ignoran en silencio: no se
      // envía ningún page_view ni se crean las cookies _ga. Por eso esto
      // tiene que ser una función clásica que empuje `arguments`.
      function gtagRaw() {
        w.dataLayer!.push(arguments);
      }
      const gtag = gtagRaw as unknown as (...args: unknown[]) => void;
      w.gtag = gtag;

      // Consent Mode: se concede solo analítica. Nada de publicidad.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'granted',
      });

      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
      document.head.appendChild(s);

      gtag('js', new Date());
      gtag('config', gaId);
    };

    const show = () => {
      banner.hidden = false;
      document.body.classList.add('has-cookie-banner');
    };

    const hide = () => {
      banner.hidden = true;
      document.body.classList.remove('has-cookie-banner');
    };

    const decide = (granted: boolean) => {
      safeSet(granted ? 'granted' : 'denied');
      hide();
      if (granted) {
        loadGA();
      } else if (loaded) {
        // Ya se había aceptado antes y ahora se retira: gtag está cargado en
        // esta página y no se puede "descargar". Recargamos para que quede
        // limpia de verdad, no solo a efectos de la próxima visita.
        location.reload();
      }
    };

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => decide(true));
    banner.querySelector('[data-cookie-reject]')?.addEventListener('click', () => decide(false));

    // Estado inicial: solo cargamos GA si ya había un "sí" previo.
    const saved = safeGet();
    if (saved === 'granted') loadGA();
    else if (saved !== 'denied') show();

    // Punto de entrada para retirar o cambiar el consentimiento (lo usa el
    // botón de /privacidad). Cambiar a "rechazar" no puede descargar gtag
    // de la página ya abierta, así que se recarga para dejarla limpia.
    (window as unknown as { mdsCookies?: unknown }).mdsCookies = {
      abrir: show,
      estado: () => safeGet(),
      revocar: () => {
        safeSet('denied');
        location.reload();
      },
    };
  }
</script>

<style>
  /* Tarjeta compacta anclada abajo a la izquierda. Deja libre la esquina
     inferior derecha, que es donde vive el botón de WhatsApp. */
  .cookie-banner {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 90;
    width: min(340px, calc(100vw - 40px));
    background: var(--color-crema);
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px -24px rgba(20, 22, 27, 0.32);
    padding: 18px 20px 16px;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.94rem;
    letter-spacing: -0.015em;
    margin: 0 0 6px;
  }

  .cookie-banner__body {
    margin: 0 0 var(--space-4);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-gris-texto);
  }

  .cookie-banner__body a {
    color: var(--color-zafiro);
  }

  .cookie-banner__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  /* Los dos botones comparten tamaño, tipografía y peso: la AEPD exige que
     rechazar sea tan fácil y tan visible como aceptar. */
  .cookie-btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-tinta);
    background: transparent;
    color: var(--color-tinta);
    cursor: pointer;
    transition: background var(--duration-hover) ease, color var(--duration-hover) ease,
      border-color var(--duration-hover) ease;
  }

  .cookie-btn:hover {
    border-color: var(--color-zafiro);
    color: var(--color-zafiro);
  }

  .cookie-btn[data-cookie-accept] {
    background: var(--color-tinta);
    color: var(--color-crema);
  }

  .cookie-btn[data-cookie-accept]:hover {
    background: var(--color-zafiro);
    border-color: var(--color-zafiro);
    color: var(--color-crema);
  }

  @media (max-width: 980px) {
    .cookie-banner {
      left: 16px;
      right: 16px;
      bottom: 16px;
      width: auto;
    }
  }
</style>

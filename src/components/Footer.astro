---
import { site, routes } from '../config/site';

interface Link {
  label: string;
  href: string;
}

interface Props {
  variant?: 'full' | 'compact' | 'minimal';
  links?: Link[];
}

const { variant = 'compact', links } = Astro.props;
const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;

const compactLinks: Link[] = links ?? [
  { label: 'Cómo funciona', href: `${routes.home}#como-funciona` },
  { label: 'Calcula tu ahorro', href: `${routes.home}#calculadora` },
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'WhatsApp', href: whatsappHref },
  { label: 'Privacidad', href: routes.privacidad },
];

const minimalLinks: Link[] = links ?? [
  { label: 'Privacidad', href: routes.privacidad },
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'WhatsApp', href: whatsappHref },
];
---

<footer class:list={['site-footer', `site-footer--${variant}`]}>
  <div class="container">
    {
      variant === 'full' && (
        <>
          <div class="site-footer__grid">
            <div>
              <a href={routes.home} class="site-footer__brand">
                <span class="site-footer__dot" aria-hidden="true"></span>
                {site.name.toUpperCase()}
              </a>
              <p class="site-footer__tagline">
                Diagnosticamos el proceso, diseñamos la solución de IA y la construimos contigo.
              </p>
            </div>
            <div>
              <p class="site-footer__heading">Navegación</p>
              <div class="site-footer__col">
                <a href={`${routes.home}#como-funciona`}>Cómo funciona</a>
                <a href={`${routes.home}#resolvemos`}>Qué resolvemos</a>
                <a href={`${routes.home}#calculadora`}>Calcula tu ahorro</a>
                <a href={`${routes.home}#faq`}>Preguntas frecuentes</a>
                <a href={routes.casos}>Catálogo de soluciones</a>
                <a href={routes.quienesSomos}>Quiénes somos</a>
              </div>
            </div>
            <div>
              <p class="site-footer__heading">Contacto</p>
              <div class="site-footer__col">
                <a href={`mailto:${site.email}`}>{site.email}</a>
                <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                <a href={`${routes.home}#diagnostico`}>Empezar el diagnóstico</a>
                <a href={routes.privacidad}>Privacidad</a>
              </div>
            </div>
          </div>
          <div class="site-footer__bottom">
            <p>© {year} {site.name}</p>
            <p class="site-footer__slogan">IA · Automatización · Datos · Software</p>
          </div>
        </>
      )
    }

    {
      variant === 'compact' && (
        <>
          <div class="site-footer__row">
            <a href={routes.home} class="site-footer__brand">
              <span class="site-footer__dot" aria-hidden="true"></span>
              {site.name.toUpperCase()}
            </a>
            <div class="site-footer__inline-links">
              {compactLinks.map((link) => (
                <a href={link.href} target={link.href === whatsappHref ? '_blank' : undefined} rel={link.href === whatsappHref ? 'noopener noreferrer' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          </div>
          <div class="site-footer__bottom">
            <p>© {year} {site.name}</p>
            <p class="site-footer__slogan">IA · Automatización · Datos · Software</p>
          </div>
        </>
      )
    }

    {
      variant === 'minimal' && (
        <div class="site-footer__row site-footer__row--minimal">
          <p class="site-footer__copyright">© {year} {site.name}</p>
          <div class="site-footer__inline-links">
            {minimalLinks.map((link) => (
              <a href={link.href} target={link.href === whatsappHref ? '_blank' : undefined} rel={link.href === whatsappHref ? 'noopener noreferrer' : undefined}>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-tinta);
    color: var(--color-crema);
  }

  .site-footer--full {
    padding: var(--space-12) 0 var(--space-6);
  }

  .site-footer--compact {
    padding: 44px 0 var(--space-6);
  }

  .site-footer--minimal {
    padding: var(--space-8) 0 var(--space-5-5);
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2-5);
    color: var(--color-crema);
    text-decoration: none;
  }

  .site-footer__dot {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: var(--color-zafiro-claro);
  }

  .site-footer__tagline {
    margin: var(--space-3-5) 0 0;
    color: #9aa3a8;
    font-size: 0.92rem;
    max-width: 30ch;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-12);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-gris-oscuro-tenue);
    margin: 0 0 var(--space-3-5);
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
  }

  .site-footer__col a,
  .site-footer__inline-links a {
    font-size: 0.9rem;
    color: #c9cfd3;
    text-decoration: none;
    transition: color var(--duration-hover) ease;
  }

  .site-footer__col a:hover,
  .site-footer__inline-links a:hover {
    color: var(--color-crema);
  }

  .site-footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .site-footer__row--minimal {
    padding-top: 0;
  }

  .site-footer__inline-links {
    display: flex;
    gap: var(--space-5-5);
    flex-wrap: wrap;
  }

  .site-footer__copyright {
    font-size: 0.8rem;
    color: var(--color-gris-oscuro-tenue);
    margin: 0;
  }

  .site-footer__bottom {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-tinta-suave);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3-5);
    flex-wrap: wrap;
  }

  .site-footer__bottom p:first-child {
    font-size: 0.8rem;
    color: var(--color-gris-oscuro-tenue);
    margin: 0;
  }

  .site-footer__slogan {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro-tenue);
    margin: 0;
  }

  @media (max-width: 980px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>

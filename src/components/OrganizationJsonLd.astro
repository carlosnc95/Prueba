---
import { site } from '../config/site';

const data = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.domain,
  logo: new URL(site.ogImage, site.domain).toString(),
  description: 'Diagnóstico y desarrollo de automatizaciones con IA para procesos de empresa.',
  email: site.email,
  areaServed: 'ES',
  sameAs: [],
  knowsAbout: ['Automatización de procesos', 'Inteligencia artificial aplicada', 'Análisis de datos', 'Desarrollo de software'],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, routes } from '../config/site';

export const prerender = true;

const secciones = [
  {
    title: 'Qué recogemos',
    text: 'Únicamente lo que escribes en el diagnóstico: descripción del proceso, sector, horas dedicadas y tu dirección de email. No usamos cookies de seguimiento ni perfilado publicitario.',
  },
  {
    title: 'Para qué',
    text: 'Para preparar tu diagnóstico y responderte. La base legal es tu consentimiento, que otorgas de forma expresa al enviar el formulario.',
  },
  {
    title: 'Cuánto tiempo',
    text: 'Conservamos la información mientras dure la relación y, después, el plazo legal exigible. Puedes pedir su borrado en cualquier momento.',
  },
  {
    title: 'Con quién se comparte',
    text: 'Con nadie con fines comerciales. Solo con los proveedores tecnológicos necesarios para prestar el servicio (correo y alojamiento), sujetos a contrato de encargo de tratamiento.',
  },
];
---

<BaseLayout
  title={`Política de privacidad · ${site.name}`}
  description="Qué datos recogemos en el diagnóstico de Sira, para qué los usamos y cómo ejercer tus derechos."
  headerShowCta={false}
  headerSticky={false}
  footerVariant="minimal"
  footerLinks={[
    { label: site.email, href: `mailto:${site.email}` },
    { label: 'WhatsApp', href: `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}` },
  ]}
>
  <section class="privacidad">
    <p class="privacidad__eyebrow">Legal</p>
    <h1 class="privacidad__title">Política de privacidad</h1>
    <p class="privacidad__intro">
      Borrador de trabajo. Antes de publicar debe revisarlo un asesor legal y completarse con los datos de la
      sociedad.
    </p>

    <div class="privacidad__cards">
      <div class="privacidad__card">
        <h2>Quién trata tus datos</h2>
        <p>
          {site.name} (pendiente de completar con razón social, NIF y domicilio). Contacto:{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      {
        secciones.map((s) => (
          <div class="privacidad__card">
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </div>
        ))
      }
      <div class="privacidad__card">
        <h2>Tus derechos</h2>
        <p>
          Acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>. También puedes reclamar ante la Agencia Española de
          Protección de Datos.
        </p>
      </div>
    </div>

    <p class="privacidad__back"><a href={routes.home}>← Volver al inicio</a></p>
  </section>
</BaseLayout>

<style>
  .privacidad {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-12) var(--container-pad) var(--space-16);
  }

  .privacidad__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-zafiro-oscuro);
    margin: 0 0 var(--space-4);
  }

  .privacidad__title {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
  }

  .privacidad__intro {
    margin: 0 0 var(--space-8);
    color: var(--color-gris-texto);
    font-size: 1.02rem;
    max-width: 60ch;
  }

  .privacidad__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
  }

  .privacidad__card {
    background: var(--color-crema-media);
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
  }

  .privacidad__card h2 {
    font-size: 1.08rem;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .privacidad__card p {
    margin: 0;
    color: var(--color-gris-texto);
  }

  .privacidad__back {
    margin: var(--space-8) 0 0;
    font-size: 0.9rem;
    color: var(--color-gris-oscuro-tenue);
  }

  @media (max-width: 980px) {
    .privacidad {
      padding-inline: var(--container-pad-narrow);
    }
  }
</style>

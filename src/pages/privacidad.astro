---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, routes } from '../config/site';

export const prerender = true;

const secciones = [
  {
    title: 'Qué recogemos',
    text: 'Lo que escribes en el diagnóstico: descripción del proceso, sector, horas dedicadas, tu nombre y tu email. Y, solo si aceptas las cookies de medición, datos de navegación agregados a través de Google Analytics: páginas vistas, tiempo en el sitio, país, tipo de dispositivo y de dónde llegas. Si las rechazas, no se instala ninguna cookie y no se recoge nada de eso.',
  },
  {
    title: 'Para qué',
    text: 'Para preparar tu diagnóstico y responderte. La base legal es tu consentimiento, que otorgas de forma expresa al enviar el formulario.',
  },
  {
    title: 'Cuánto tiempo',
    text: 'Conservamos la información mientras dure la relación y, después, el plazo legal exigible. Puedes pedir su borrado en cualquier momento.',
  },
  {
    title: 'Cookies',
    text: 'Las únicas cookies que usamos son las de medición de Google Analytics, y no se instalan hasta que las aceptas: hasta entonces el script ni siquiera se descarga. Rechazarlas no limita nada de la web. Guardamos tu decisión en el navegador para no volver a preguntarte, y puedes cambiarla cuando quieras desde el botón que hay más abajo.',
  },
  {
    title: 'Con quién se comparte',
    text: 'Con nadie con fines comerciales. Solo con los proveedores tecnológicos necesarios para prestar el servicio: alojamiento, envío de correo y, si las aceptas, Google Analytics. Google puede tratar esos datos fuera de la Unión Europea, amparado en las cláusulas contractuales tipo de la Comisión Europea. No usamos los datos para publicidad ni los cruzamos con los del formulario.',
  },
];
---

<BaseLayout
  title={`Política de privacidad · ${site.name}`}
  description={`Qué datos recogemos en el diagnóstico de ${site.name}, para qué los usamos y cómo ejercer tus derechos.`}
  headerShowCta={false}
  headerSticky={false}
  footerVariant="minimal"
  footerLinks={[
    { label: site.email, href: `mailto:${site.email}` },
    { label: 'WhatsApp', href: `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}` },
  ]}
>
  <section class="privacidad">
    <p class="privacidad__eyebrow">Legal</p>
    <h1 class="privacidad__title">Política de privacidad</h1>
    {/*
      PENDIENTE: falta la identificación completa del responsable (razón social
      o nombre completo, NIF y domicilio fiscal), obligatoria por el art. 13
      del RGPD y el art. 10 de la LSSI-CE. Hasta añadirla, esta página informa
      del tratamiento pero NO cumple del todo. Completar antes de invertir en
      captación de tráfico.
    */}
    <p class="privacidad__intro">
      Qué datos recogemos cuando nos cuentas tu caso, para qué los usamos y cómo puedes controlarlos.
    </p>

    <div class="privacidad__cards">
      <div class="privacidad__card">
        <h2>Quién trata tus datos</h2>
        <p>
          {site.name}. Para cualquier cuestión sobre tus datos, escribe a{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      {
        secciones.map((s) => (
          <div class="privacidad__card">
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </div>
        ))
      }
      {
        site.ga4Id && (
          <div class="privacidad__card">
            <h2>Cambiar tu decisión sobre las cookies</h2>
            <p>
              Puedes revisar o retirar el consentimiento cuando quieras. Retirarlo es tan sencillo como
              darlo.
            </p>
            <div class="privacidad__consent">
              <button type="button" class="privacidad__btn" data-consent-open>
                Cambiar preferencias
              </button>
              <span class="privacidad__estado" data-consent-estado />
            </div>
          </div>
        )
      }
      <div class="privacidad__card">
        <h2>Tus derechos</h2>
        <p>
          Acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>. También puedes reclamar ante la Agencia Española de
          Protección de Datos.
        </p>
      </div>
    </div>

    <p class="privacidad__back"><a href={routes.home}>← Volver al inicio</a></p>
  </section>

  <script>
    // El banner (CookieBanner.astro) expone window.mdsCookies al cargarse.
    const api = () => (window as unknown as { mdsCookies?: { abrir(): void; estado(): string | null } }).mdsCookies;

    const btn = document.querySelector<HTMLButtonElement>('[data-consent-open]');
    const estadoEl = document.querySelector<HTMLElement>('[data-consent-estado]');

    // Se lee el almacenamiento directamente y no a través de window.mdsCookies:
    // el script del banner puede no haberse ejecutado todavía cuando pintamos.
    const pintarEstado = () => {
      if (!estadoEl) return;
      let v: string | null = null;
      try {
        v = localStorage.getItem('mds:consent:analytics');
      } catch {
        /* almacenamiento bloqueado */
      }
      estadoEl.textContent =
        v === 'granted' ? 'Ahora mismo: aceptadas.' : v === 'denied' ? 'Ahora mismo: rechazadas.' : 'Aún no has elegido.';
    };

    btn?.addEventListener('click', () => {
      api()?.abrir();
    });

    pintarEstado();
  </script>
</BaseLayout>

<style>
  .privacidad {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--space-12) var(--container-pad) var(--space-16);
  }

  .privacidad__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-zafiro-oscuro);
    margin: 0 0 var(--space-4);
  }

  .privacidad__title {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
  }

  .privacidad__intro {
    margin: 0 0 var(--space-8);
    color: var(--color-gris-texto);
    font-size: 1.02rem;
    max-width: 60ch;
  }

  .privacidad__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
  }

  .privacidad__card {
    background: var(--color-crema-media);
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
  }

  .privacidad__card h2 {
    font-size: 1.08rem;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .privacidad__card p {
    margin: 0;
    color: var(--color-gris-texto);
  }

  .privacidad__consent {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .privacidad__btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 11px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-tinta);
    background: transparent;
    color: var(--color-tinta);
    cursor: pointer;
    transition: border-color var(--duration-hover) ease, color var(--duration-hover) ease;
  }

  .privacidad__btn:hover {
    border-color: var(--color-zafiro);
    color: var(--color-zafiro);
  }

  .privacidad__estado {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-gris-oscuro-tenue);
  }

  .privacidad__back {
    margin: var(--space-8) 0 0;
    font-size: 0.9rem;
    color: var(--color-gris-oscuro-tenue);
  }

  @media (max-width: 980px) {
    .privacidad {
      padding-inline: var(--container-pad-narrow);
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import FamiliaTiles from '../components/casos/FamiliaTiles.astro';
import { site, routes } from '../config/site';

export const prerender = true;

const headerNav = [
  { label: 'Inicio', href: routes.home },
  { label: 'Quiénes somos', href: routes.quienesSomos },
];

const criterios = [
  { num: '01', text: 'Lo que se repite muchas veces.' },
  { num: '02', text: 'Lo que tiene criterio explicable.' },
  { num: '03', text: 'Lo que ya genera datos hoy.' },
];
---

<BaseLayout
  title={`Soluciones de automatización con IA · ${site.name}`}
  description="24 soluciones de IA y automatización agrupadas en seis familias: documentos y datos, clientes, procesos, comercial, operaciones y talento."
  headerNavItems={headerNav}
>
  <Fragment slot="head">
    <OrganizationJsonLd />
  </Fragment>

  <section class="casos-hero">
    <div class="container">
      <p class="eyebrow">Catálogo</p>
      <h1 class="casos-hero__title">Qué se puede automatizar con IA</h1>
      <p class="casos-hero__lead">Elige una familia y mira las soluciones que montamos.</p>
    </div>
  </section>

  <FamiliaTiles />

  <section class="casos-criterios">
    <div class="container">
      <div class="casos-criterios__grid" data-reveal>
        <div>
          <h2 class="casos-criterios__title">Qué automatizamos primero</h2>
        </div>
        {
          criterios.map((c) => (
            <div class="casos-criterios__item">
              <span class="casos-criterios__num">{c.num}</span>
              <p class="casos-criterios__text">{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="casos-cta">
    <div class="container" data-reveal>
      <div class="casos-cta__box">
        <h2 class="casos-cta__title">¿No ves tu caso aquí? Cuéntanoslo.</h2>
        <a href={`${routes.home}#diagnostico`} class="casos-cta__btn">Empezar el diagnóstico <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .casos-hero {
    padding: var(--space-12) 0 34px;
  }

  .casos-hero__title {
    font-size: clamp(2.5rem, 4.8vw, 3.9rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 22ch;
  }

  .casos-hero__lead {
    margin-top: var(--space-5);
    font-size: 1.1rem;
    color: var(--color-gris-texto);
    max-width: 44ch;
  }

  .casos-criterios {
    background: var(--color-tinta);
    color: var(--color-crema);
    padding: var(--space-12) 0;
  }

  .casos-criterios__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 26px 32px;
    align-items: start;
  }

  .casos-criterios__title {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 18ch;
    color: var(--color-crema);
  }

  .casos-criterios__item {
    border-top: 1px solid var(--color-tinta-suave);
    padding-top: var(--space-4);
  }

  .casos-criterios__num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-zafiro-claro);
  }

  .casos-criterios__text {
    margin: 10px 0 0;
    font-size: 0.95rem;
    color: #c9cfd3;
  }

  .casos-cta {
    padding: var(--space-12) 0 var(--space-16);
  }

  .casos-cta__box {
    background: var(--color-crema-media);
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-2xl);
    padding: 52px 40px;
    text-align: center;
  }

  .casos-cta__title {
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 auto 24px;
    max-width: 24ch;
  }

  .casos-cta__btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 16px 26px;
    background: var(--color-tinta);
    color: var(--color-crema);
    border: 1px solid var(--color-tinta);
    border-radius: 10px;
    text-decoration: none;
    transition: background var(--duration-hover) ease, border-color var(--duration-hover) ease,
      box-shadow var(--duration-hover) ease, transform var(--duration-hover) ease;
  }

  .casos-cta__btn:hover {
    background: var(--color-zafiro);
    border-color: var(--color-zafiro);
    box-shadow: 0 14px 28px -14px #2d5b9e80;
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .casos-criterios__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
